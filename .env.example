# Copy to .env and adjust. docker compose and manage.py both read this file.

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost
# Public origin — used for canonical URLs, Open Graph tags and sitemap.xml
SITE_URL=http://127.0.0.1:8008
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8008,http://localhost:8008
LOG_LEVEL=INFO

# --- Ports ---
# Host port the site is served on
WEB_PORT=8008
# Host port for the database (container-internal port is always 5432)
POSTGRES_PORT_EXTERNAL=5438

# --- Database ---
# Remove POSTGRES_DB/POSTGRES_USER to fall back to a local SQLite file.
POSTGRES_DB=studio
POSTGRES_USER=studio
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Admin account ---
# Created by `manage.py seed_demo` on first boot if the username is free.
# Leave the password empty and seed_demo generates a random one, printing it
# once in the startup log. Wrap values containing $ in single quotes.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=admin@example.com

# --- Application ---
# Rate limit for the public contact form
MESSAGE_THROTTLE_RATE=10/hour
SUBSCRIBE_THROTTLE_RATE=10/hour
# Cache lifetime (seconds) for the aggregated /api/site/ payload
CACHE_TIMEOUT=3600
TIME_ZONE=Europe/Kyiv
LANGUAGE_CODE=uk-ua

# Vite dev server needs these to reach the API cross-origin (`npm run dev` only)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend build ---
# Base URL the SPA calls. Empty = same origin (production/compose default).
VITE_API_BASE_URL=

# --- Production only (compose.prod.yaml / Caddy) ---
# Address Caddy serves. Bare domain = automatic HTTPS; prefix with http:// to
# serve plain HTTP, which is useful to test reachability before requesting a cert.
SITE_ADDRESS=example.com
# Contact address Let's Encrypt uses for expiry warnings.
ACME_EMAIL=you@example.com
# Send session/CSRF cookies over HTTPS only. Requires a working certificate.
COOKIE_SECURE=True
# Redundant behind Caddy (it redirects already), harmless as defence in depth.
SECURE_SSL_REDIRECT=True
# HSTS. Browsers cache this for the whole duration and will refuse plain HTTP
# for the domain — turn it on only once HTTPS is verified. 31536000 = 1 year.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# New contact-form leads as Telegram messages (main/notify.py): a bot from @BotFather and your
# chat id. The bot only sends, it does not talk to visitors. Leave empty to only keep leads in the admin.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
